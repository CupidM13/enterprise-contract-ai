# ==============================================================================
# Enterprise Contract & Vendor Risk Automation Engine - Environment Config
# ==============================================================================

# Option A: Google AI Studio (100% Free Tier - No credit card required)
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_free_gemini_api_key_here
USE_VERTEX_AI=false

# Option B: Google Cloud Vertex AI (Enterprise Mode)
# Set USE_VERTEX_AI=true and provide your GCP project and location
# USE_VERTEX_AI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Free-Tier Model Routing (Defaults)
MODEL_EXTRACTION=gemini-3.5-flash-lite
MODEL_AUDIT=gemini-3.8-flash
MODEL_EMBEDDING=gemini-embedding-001

# Rate Limiter & Free-Tier Quota Settings
RATE_LIMIT_RPM=15
RATE_LIMIT_MIN_INTERVAL=4.0
MAX_RETRIES=5

# Server Ports
API_PORT=8000
PORT=7860
